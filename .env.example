# Option 1: Unified OpenAI-compatible provider (OpenAI, Ollama, vLLM, LM Studio)
OPENAI_API_KEY="your-api-key"
RAG_API_BASE="https://api.openai.com/v1"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_CHAT_MODEL="gpt-4o-mini"

# Option 2: Split providers (e.g. Sarvam AI / OpenRouter for Chat + Local Ollama for Embeddings)
# RAG_CHAT_BASE="https://api.sarvam.ai/v2"
# RAG_CHAT_API_KEY="your-chat-api-key"
# RAG_CHAT_MODEL="deepseekv4.1-flash-1017"
#
# RAG_EMBEDDING_BASE="http://127.0.0.1:11434/v1"
# RAG_EMBEDDING_API_KEY="ollama"
# RAG_EMBEDDING_MODEL="embeddinggemma-2"

# Optional: Custom database path (defaults to .rag/index.sqlite)
# RAG_DB=".rag/index.sqlite"
